# Client-side VITE_* env vars are INLINED INTO THE BROWSER BUNDLE at `vite build` time.
# ── CRITICAL SECURITY RULE ──────────────────────────────────────────────────
# NEVER prefix a secret (service_role key / sk_live_ / admin signing salt) with VITE_.
# Only use VITE_* for values that are safe to publish publicly in the shipped bundle.
# ────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Stripe ──────────────────────────────────────────────────────────────────
# Publishable key (VITE_* → intentionally shipped to the browser — safe to expose).
# On Netlify: set VITE_STRIPE_PUBLISHABLE_KEY in Site configuration → Environment variables.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# TEST SECRET key (VITE_* prefix → LOCAL DEV ONLY, uses sk_test_*).
# The transport switch in src/lib/stripe.ts uses this direct Stripe SDK path
# ONLY when hostname === localhost / 127.0.0.1 / *.local (vite dev server).
# It is NEVER used on Netlify / live URLs — those go through Netlify Functions
# which read the separate STRIPE_SECRET_KEY (server-side, no VITE_ prefix, below).
VITE_STRIPE_SECRET_KEY=sk_test_your-secret-key-local-only

# ── Contact forms (Formspree) ───────────────────────────────────────────────
# Direct AJAX Formspree endpoint — runs in browser, so CORS must be enabled on Formspree dashboard.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/yourformid

# ============================================================================
# SERVER-SIDE ONLY (no VITE_ prefix) → injected by Netlify into Function runtime
# ============================================================================
# The variables below are ONLY read by netlify/functions/*.ts via process.env.*
# and NEVER shipped to the browser. Set BOTH in Netlify Site Configuration →
# Environment variables AND here (for local `netlify dev` runs).

# Supabase URL (duplicate of VITE_SUPABASE_URL; set to the same value as above).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE KEY (DO NOT ADD VITE_ PREFIX — WOULD BYPASS ALL ROW LEVEL
# SECURITY POLICIES AND ALLOW ANY VISITOR WITH DEVTOOLS TO READ/WRITE EVERY TABLE!).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-SERVER-ONLY

# Stripe LIVE/TEST secret key for Netlify Functions payments. Replace with sk_live_...
# in Netlify Environment Variables when going live. Used by:
#   netlify/functions/create-checkout.ts
#   netlify/functions/retrieve-checkout.ts
STRIPE_SECRET_KEY=sk_live_or_sk_test_NETLIFY_FUNCTIONS_ONLY

# Admin session signing salt for admin-gateway. Any long random string (≥32 chars recommended).
# Currently-signed-in BBB admins keep their session if BBB_ADMIN_SIGN_ALGO=legacy matching
# the client-side adminSignature() salt; for HMAC hardening set algo=hmac below and
# change to a new random long salt, and distribute new login sessions via Supabase RPC.
BBB_ADMIN_SIGN_SALT=change-me-to-a-long-random-string-AT-LEAST-32-characters

# legacy = match currently signed client sessions for zero-logout deploy, recommended
# for initial deploy so currently-logged admins aren't logged out.
# hmac   = HMAC-SHA256 (strongly recommended long-term; rotate the salt above when switching).
BBB_ADMIN_SIGN_ALGO=legacy

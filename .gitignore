# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# ── Environment files ────────────────────────────────────────────────────────
# NEVER commit real env files with secrets to git.
# .env.example is intentionally EXCLUDED from the wildcard below (kept tracked)
# because it only contains placeholders / dummy values for new contributors.
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Git history backups created during repo move scrub � NEVER push these, they carry the old leaked .env blobs
.git.BACKUP-*
.git.BACKUP-*/**
